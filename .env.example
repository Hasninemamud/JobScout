# Where job data comes from: scrape | api | demo
#   scrape = LinkedIn's public (signed-out) job pages. No key needed. Against LinkedIn's ToS; may be throttled.
#   api    = licensed RapidAPI provider (needs RAPIDAPI_KEY)
#   demo   = offline sample data
# Leave empty to auto-select: api if RAPIDAPI_KEY is set, otherwise scrape.
JOB_SOURCE=

RAPIDAPI_KEY=
RAPIDAPI_HOST=linkedin-job-search-api.p.rapidapi.com
JOBS_ENDPOINT_1H=/active-jb-1h
JOBS_ENDPOINT_24H=/active-jb-24h
JOBS_ENDPOINT_7D=/active-jb-7d

PORT=3000
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
# How many reverse proxies sit in front of this server (0 = none). Needed so each visitor gets their own
# rate-limit bucket instead of everyone sharing the proxy's address. Only set it if you really run behind that many.
TRUST_PROXY=0
